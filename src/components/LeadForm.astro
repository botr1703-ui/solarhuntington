---
// Phase 23.11: default to the Forge form-handler worker so a new
// phantom doesn't ship "broken" because PUBLIC_FORM_ACTION wasn't
// set in the env. Override with the env var if you ever want to
// post somewhere else.
const action = import.meta.env.PUBLIC_FORM_ACTION
  || 'https://forge-form-handler.botr1703.workers.dev';
---

<form class="form" method="post" action={action}>
  <input type="hidden" name="_site" value="solarhuntington" />
  <input type="hidden" name="_email_relay" value="info@webtastictech.com" />
  <input type="hidden" name="_cc" value="botr1703@gmail.com" />
  <input type="hidden" name="inquiry_type" value="solar-callback" />
  <input type="hidden" name="_redirect" value="/thank-you/" />
  <input type="text" name="_honeypot" tabindex="-1" autocomplete="off"
         aria-hidden="true"
         style="position:absolute;left:-9999px;opacity:0;pointer-events:none;" />
  <label>
    Name
    <input type="text" name="name" required autocomplete="name" />
  </label>
  <label>
    Phone
    <input type="tel" name="phone" required autocomplete="tel" />
  </label>
  <label>
    Email
    <input type="email" name="email" autocomplete="email" />
  </label>
  <!-- Qualifiers (2026-09-11 conversion-tracking pilot): the two answers
       that separate a buyer from a browser for residential solar. The GA4
       generate_lead conversion fires only when both qualify; every submit
       still records form_submit, so nothing is lost — the ad platforms just
       stop being taught to find renters and $80/month bills. -->
  <label>
    Do you own the home?
    <select name="homeowner" required>
      <option value="">Choose one</option>
      <option value="yes">Yes, I own it</option>
      <option value="no">No, I rent</option>
      <option value="unsure">Not sure / other</option>
    </select>
  </label>
  <label>
    Average monthly electric bill
    <select name="electric_bill" required>
      <option value="">Choose one</option>
      <option value="under-150">Under $150</option>
      <option value="150-300">$150 – $300</option>
      <option value="over-300">Over $300</option>
    </select>
  </label>
  <input type="hidden" name="lead_qualified" value="" />
  <label>
    How can we help?
    <textarea name="message" rows={4} />
  </label>
  <button type="submit">Request a call back</button>
</form>


<script is:inline>
  /* GA4 form-submit reliability pattern.
     2026-06-23 fix: previous handler fired gtag in the submit listener
     without preventing default. The form would navigate to the worker
     before gtag.js had time to flush the beacons, so events never
     reached GA4 (Director dispatch verified zero conversions). New
     flow: capture submit, fire events with event_callback, then submit
     the form once GA confirms (or after a 500ms timeout fallback).
     Avoids dependence on `transport_type: 'beacon'` actually winning
     the race against navigation. */
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form.form').forEach(function (form) {
      var submitted = false;
      form.addEventListener('submit', function (e) {
        if (submitted) return; /* already in flight from our own form.submit() */
        if (typeof gtag !== 'function') return; /* let form submit normally */

        e.preventDefault();
        function resubmit() {
          if (submitted) return;
          submitted = true;
          form.submit();
        }

        /* Qualify before we tell the ad platforms anything. A homeowner
           with a $150+ bill is a buyer; a renter or an $80 bill is a
           browser. Both are recorded (form_submit), only the buyer is a
           conversion (generate_lead). */
        var homeowner = (form.querySelector('[name="homeowner"]') || {}).value || '';
        var bill = (form.querySelector('[name="electric_bill"]') || {}).value || '';
        var qualified = homeowner === 'yes' && bill !== '' && bill !== 'under-150';
        var qf = form.querySelector('[name="lead_qualified"]');
        if (qf) qf.value = qualified ? 'true' : 'false';

        /* Enhanced conversions: hand the platform the identifiers it
           matches on, so the conversion is attributed to a real person. */
        var email = ((form.querySelector('[name="email"]') || {}).value || '').trim().toLowerCase();
        var phone = ((form.querySelector('[name="phone"]') || {}).value || '').replace(/[^0-9+]/g, '');
        if (email || phone) {
          var ud = {};
          if (email) ud.email = email;
          if (phone) ud.phone_number = phone.indexOf('+') === 0 ? phone : '+1' + phone.replace(/^1/, '');
          gtag('set', 'user_data', ud);
        }

        gtag('event', 'form_submit', {
          event_category: 'lead',
          event_label: 'solar_callback_form',
          lead_qualified: qualified,
          homeowner: homeowner,
          electric_bill: bill,
          page_path: window.location.pathname,
          transport_type: 'beacon',
          event_callback: resubmit,
          event_timeout: 400,
        });

        if (qualified) {
          gtag('event', 'generate_lead', {
            event_category: 'lead',
            event_label: 'solar_callback_form',
            lead_qualified: true,
            transport_type: 'beacon',
            value: 1,
            currency: 'USD',
          });
        }

        /* Belt-and-suspenders: never let the user wait more than 500ms. */
        setTimeout(resubmit, 500);
      });
    });
  });
</script>
