---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { caseStudies, services } from '../config/site';

const business = import.meta.env.PUBLIC_BUSINESS_NAME || 'Huntington Solar Co';
const city = import.meta.env.PUBLIC_CITY || 'Huntington';
const state = import.meta.env.PUBLIC_STATE || 'NY';
const phoneTel = import.meta.env.PUBLIC_PHONE_TEL || '+16317598716';
const phoneDisplay = import.meta.env.PUBLIC_PHONE_DISPLAY || '(631) 759-8716';
const siteUrl =
  import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || 'https://www.solarhuntington.com';

// Targets high-commercial-intent "best solar company Long Island" queries
// (impressions at pos 83-93, no clicks as of the 2026-07 GSC pull).
//
// 2026-08-01 liability fix: this page was originally anchored on a 4.9-of-127
// aggregateRating and five invented customer testimonials rendered as Review
// schema. Both are gone. The page now stands on the buyer's checklist — how
// to evaluate ANY Long Island installer — plus how we answer those questions
// about our own process. Do NOT re-add ratings, review counts, install
// counts, BBB claims, certifications, or customer quotes to this page.
//
// 2026-08-01 liability pass 2: the three "why us" cards were removed in full.
// Two of them made operational claims the business cannot currently make — an
// employed crew ("the crew that quotes your install is the crew on your roof")
// and an open offer to run flat-rate diagnostics on any Suffolk County system.
// The page now stands entirely on the buyer's checklist, which is advice about
// evaluating any Long Island installer and asserts nothing about this one.
// Do NOT re-add crew claims, dispatch radii, response times, or service prices.
const title = `How to Choose a Solar Company on Long Island | ${business}`;
const description =
  'How to pick a solar company on Long Island — the questions that actually matter about subcontracting, warranty scope, and long-term service.';

// Buyer checklist — the questions to ask any LI solar company before signing.
const checklist = [
  'Are you NABCEP-certified, and who specifically supervises my install?',
  'Do you subcontract the installation, or is it your own W-2 crew?',
  'Will you service my system if the original hardware fails in year 8?',
  'Is the NY-Sun rebate already applied in this quote, or added later?',
  'What does your workmanship + roof-penetration warranty actually cover?',
  'Can I see recent installs in my town, with real payback numbers?',
];

// 2026-08-01 liability fix: the LocalBusiness node here previously carried an
// aggregateRating (4.9 / 127) and a review array built from invented customer
// quotes. Both removed. This node must stay rating-free and review-free.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'SolarEnergyContractor'],
      '@id': `${siteUrl}/#business`,
      name: business,
      url: siteUrl,
      telephone: phoneTel,
      priceRange: '$$$',
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/why-huntington-solar/`,
      url: `${siteUrl}/why-huntington-solar/`,
      name: title,
      description: description,
      about: { '@id': `${siteUrl}/#business` },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonicalPath="/why-huntington-solar/"
  jsonLd={jsonLd}
>
  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: 'Why choose us' },
  ]} />

  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">Why {business}</p>
      <h1>How to choose a solar company on Long Island.</h1>
      <p class="lead">
        There are dozens of solar companies on Long Island. The one worth signing with is the one
        that's still answering the phone in year 20, and that gives straight answers to the
        questions below. Here's what to ask before you sign with anyone.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#contact">Get a free quote</a>
        <a class="btn btn-ghost" href={`tel:${phoneTel}`}>Call {phoneDisplay}</a>
      </div>
    </div>
  </section>

  {/* 2026-08-01: stat bar removed — it published a 4.9/5 rating, a 127-install
      count, and a BBB A+ grade, none of which could be substantiated. */}

  <section class="prose-section">
    <div class="wrap">
      <article class="prose-block">
        <h2>How to compare solar companies on Long Island</h2>
        <p>
          The difference between the best solar company on Long Island and a merely cheap one usually
          shows up years after the install — when an inverter faults, a squirrel chews a wire, or you
          go to claim a warranty. Price is easy to compare on day one; accountability is what you're
          actually buying. Before you sign with any Long Island installer, ask these:
        </p>
        <ul class="check-list">
          {checklist.map((q) => <li>{q}</li>)}
        </ul>
        <p>
          If an installer can't give you a straight answer on subcontracting, warranty scope, or
          servicing older systems, that's your answer. Below are five worked examples of how a
          north-shore system gets sized — the starting point, the hardware, and the projected
          payback.
        </p>
      </article>
    </div>
  </section>

  <section class="services">
    <div class="wrap">
      <p class="section-eyebrow">What the math looks like</p>
      <h2>Five example north-shore builds.</h2>
      <p style="max-width:60ch;margin-bottom:1.75rem;opacity:.85;">
        These are illustrative examples modelled on typical Long Island home types, system sizes,
        and PSEG Long Island rates — not records of specific completed projects.
      </p>
      <div class="grid grid-3">
        {caseStudies.map((c) => (
          <article class="svc-card">
            <h3>{c.headline}</h3>
            <p style="opacity:.85;">{c.town}, {state} · example scenario</p>
            <p>{c.system[0]}</p>
          </article>
        ))}
      </div>
      <p class="trust-foot">
        <a href="/case-studies/">See the full example builds with system specs and payback math →</a>
      </p>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <p class="section-eyebrow">Get your free quote</p>
        <h2>See how we'd handle your roof.</h2>
        <p class="contact-lead">
          Tell us your LIPA bill and roof orientation — we'll send back a system size, projected
          savings, and payback period. No salesperson visit required to see the number.
        </p>
        <p class="contact-call">
          Want to talk first? <a href={`tel:${phoneTel}`}>Call {phoneDisplay}</a>
        </p>
      </div>
      <div class="contact-form">
        <LeadForm />
      </div>
    </div>
  </section>

  <section class="related">
    <div class="wrap">
      <h2>Keep reading</h2>
      <div class="related-grid">
        <a class="related-card" href="/about/">
          <h3>About {business}</h3>
          <p>Who we are, how we work, and where we work across Suffolk County.</p>
        </a>
        <a class="related-card" href="/case-studies/">
          <h3>Example builds</h3>
          <p>Five illustrative builds with full system specs, incentive math, and payback timelines.</p>
        </a>
        <a class="related-card" href="/warranty/">
          <h3>Solar warranties</h3>
          <p>What panel, inverter, and workmanship warranties actually cover, in plain English.</p>
        </a>
        <a class="related-card" href="/locations/huntington/">
          <h3>Solar panels in Huntington</h3>
          <p>Town-specific permit, ZIP, and incentive details for Huntington, NY.</p>
        </a>
      </div>
      <p class="muted center"><a href="/">← Back to home</a></p>
    </div>
  </section>
</Layout>
